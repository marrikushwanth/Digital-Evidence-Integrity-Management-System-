# =========================================================
# DEIMS - Environment Configuration Example
# =========================================================
# Copy this file to .env and replace the values with your
# own production/development secrets.
# DO NOT COMMIT THE REAL .env FILE TO VERSION CONTROL!
# =========================================================

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_APP=app.py

# Security Secrets
# Use a strong randomly generated string for SECRET_KEY (e.g. `openssl rand -hex 32`)
SECRET_KEY=<generate-a-strong-random-secret>
# AES_SECRET_KEY MUST be exactly 32 bytes/characters long for AES-256
AES_SECRET_KEY=<generate-a-strong-32-byte-secret>
# Super Admin password for initial seeding (only used if Super Admin doesn't exist)
SUPER_ADMIN_PASSWORD=<generate-a-strong-admin-password>

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-database-password>
MYSQL_DATABASE=DEIMS

# Blockchain Configuration
# URL of your Ethereum node / Hardhat network
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Address of the deployed EvidenceRegistry contract
BLOCKCHAIN_CONTRACT_ADDRESS=<your-deployed-contract-address>
# Private key used by backend to sign verification transactions
BLOCKCHAIN_PRIVATE_KEY=<your-wallet-private-key>

# File Storage Paths (Relative to server/ or absolute)
UPLOAD_FOLDER=uploads
ENCRYPTED_FOLDER=encrypted
REPORTS_FOLDER=reports

# Server Constraints
# Maximum upload size in bytes (100MB default = 104857600)
MAX_CONTENT_LENGTH=104857600
# Comma-separated list of allowed origins for CORS (e.g. http://localhost:5173,https://myproduction.com)
ALLOWED_ORIGINS=http://localhost:5173
